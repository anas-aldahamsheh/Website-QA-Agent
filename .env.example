# System Configuration
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# SQLite database (relative to packages/database/prisma/schema.prisma)
DATABASE_URL=file:./dev.db

# Redis Connection (BullMQ Queue)
# Leave REDIS_URL unset to use the local polling worker
# REDIS_URL=redis://localhost:6380

# Object Storage Configuration (MinIO / S3)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_password
STORAGE_USE_SSL=false
STORAGE_BUCKET=sentinelqa-artifacts

# Generate a private random value of at least 32 bytes before storing credentials
ENCRYPTION_MASTER_KEY=

# Authentication Configuration (Better Auth)
BETTER_AUTH_SECRET=generate-a-random-secret-here-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Required to serve the dashboard in production (use HTTPS)
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
# A copy anyone may use: no login, one scan at a time, at most 10 pages and 5 minutes per scan
# APP_PUBLIC_MODE=true
# Skip the login on a copy that only you can reach (for example bound to localhost)
# APP_BASIC_AUTH_DISABLED=true

# AI Configuration (Gemini / LLM)
GEMINI_API_KEY=your-gemini-api-key-here
